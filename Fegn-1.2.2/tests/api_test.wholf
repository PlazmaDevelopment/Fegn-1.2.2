// API testleri

// Test yardımcı fonksiyonu
test "API entegrasyonu testi" {
    // API yöneticisi oluşturma
    fegn Api {
        baseUrl: "https://api.example.com",
        headers: {
            "Content-Type": "application/json"
        }
    }
    
    // GET isteği testi
    var response = Api.get("/test")
    assert response.status == 200
    
    // POST isteği testi
    var data = {
        test: "data"
    }
    var postResponse = Api.post("/test", data)
    assert postResponse.status == 200
    
    // Hata durumu testi
    try {
        var errorResponse = Api.get("/invalid")
    } catch (error) {
        assert error.message.contains("404")
    }
}
